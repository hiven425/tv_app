<resources>
    <style name="Theme.TvCast" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="android:colorBackground">@color/tv_bg</item>
        <item name="android:textColorPrimary">@color/tv_text_primary</item>
        <item name="android:textColorSecondary">@color/tv_text_secondary</item>
        <item name="colorAccent">@color/tv_accent</item>
        <item name="android:statusBarColor">@color/tv_bg</item>
        <item name="android:navigationBarColor">@color/tv_bg</item>
    </style>

    <style name="Theme.TvCast.Fullscreen" parent="Theme.TvCast">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
